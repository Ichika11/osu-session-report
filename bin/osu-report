#!/usr/bin/env python3
"""
osu! session report — a visual dashboard rendered to a self-contained HTML file.

Companion to `osu-stats`. Where osu-stats prints a terminal summary, this builds
a full page: top plays, progress curves, and consistency analysis, then opens it.

    osu-report                     full report for the last 6h, opens in a browser
    osu-report --term              draw it in the terminal instead — no browser
    osu-report --sixel             the HTML report rasterised inline (needs sixel)
    osu-report --hours 3           narrow the session window
    osu-report --session-top 10    best N plays inside the window   (default 10)
    osu-report --top 10            all-time best N                  (default 10)
    osu-report --fast              skip replay downloads; use cached UR only
    osu-report --offline           no API at all; render from local logs
    osu-report --no-open           write the file, don't launch a browser
    osu-report --out PATH          explicit output path

--term renders with truecolour and braille line charts; it needs a terminal that
supports 24-bit colour (foot, kitty, alacritty). --sixel needs one with sixel
graphics (foot, xterm -ti vt340, wezterm) plus chafa and firefox.

API access, credentials and UR computation are reused from osu-stats, so there
is one implementation of each. Only the presentation lives here.
"""

import argparse
import base64
import hashlib
import html
import importlib.machinery
import importlib.util
import json
import math
import os
import random
import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path
from statistics import mean, median

def find_stats():
    """
    Locate osu-stats. Next to this script first, which is how it's laid out on
    Windows and for a git checkout run in place, then the Linux bin directory.
    """
    here = Path(__file__).resolve().parent
    for cand in (here / "osu-stats", here / "osu-stats.py",
                 Path.home() / ".local" / "bin" / "osu-stats"):
        if cand.exists():
            return cand
    return here / "osu-stats"


STATS_PATH = find_stats()

# HTML reports are bulky and disposable — the durable record is the jsonl logs
# plus the Markdown digests, which are tiny.
KEEP_REPORTS = 5
KEEP_BRIEFS = 40
EMBED_FONT = False

# osu!'s hue palette, as used by lazer and osu-web.
OSU = {
    "pink": "#ff66ab", "pink_dark": "#cc5288", "pink_light": "#ff99cc",
    "purple": "#8866ee", "purple_dark": "#6644cc", "purple_light": "#aa88ff",
    "blue": "#66ccff", "blue_dark": "#4488cc",
    "yellow": "#ffcc22", "yellow_dark": "#eeaa00",
    "green": "#b3d944", "green_dark": "#88b300",
    "red": "#ff6666", "red_dark": "#ed1121",
}


def load_stats_module():
    """Import ~/.local/bin/osu-stats, which has no .py extension."""
    if not STATS_PATH.exists():
        sys.exit(f"osu-stats not found at {STATS_PATH}")
    loader = importlib.machinery.SourceFileLoader("osustats", str(STATS_PATH))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    mod.C.enabled = False          # never emit ANSI into our stdout
    return mod


ost = load_stats_module()

# one definition of where things live, shared with osu-stats so both agree on
# Windows as well as Linux
DATA_DIR = ost.DATA_DIR
REPORT_DIR = DATA_DIR / "reports"
FONT_PATH = DATA_DIR / "fonts" / "rubik.woff2"
IMG_CACHE = DATA_DIR / "images"


# ------------------------------------------------------------------- theme --

def font_face():
    """
    Embed Rubik as the stand-in for lazer's Torus, which isn't redistributable.

    Off by default: Rubik is installed system-wide here and the CSS stack falls
    through to it, so inlining 150 KB into every report would trade 60% of each
    file's size for nothing. --embed-font turns it on for a report you intend to
    send somewhere else.
    """
    if not EMBED_FONT or not FONT_PATH.exists():
        return ""
    try:
        b64 = base64.b64encode(FONT_PATH.read_bytes()).decode()
    except OSError:
        return ""
    return (f"@font-face{{font-family:'Torus Sub';src:url(data:font/woff2;base64,{b64})"
            f" format('woff2-variations');font-weight:300 900;font-display:swap}}")


def triangles(w=520, h=420, n=30, color="#ffffff", lo=0.02, hi=0.075, seed=4,
              smin=0.06, smax=0.30):
    """
    lazer's signature background motif, as a tiling data URI.

    Equilateral triangles, upright, scattered at varying size and opacity —
    the static equivalent of the field that drifts upward in the client.
    Keep the opacity low on the page backdrop: it should read as texture, not
    as content competing with the numbers on top of it.
    """
    rnd = random.Random(seed)
    shapes = []
    for _ in range(n):
        size = rnd.uniform(w * smin, w * smax)
        cx, cy = rnd.uniform(0, w), rnd.uniform(0, h)
        half, height = size / 2, size * 0.866
        pts = f"{cx:.1f},{cy - height * 2 / 3:.1f} " \
              f"{cx - half:.1f},{cy + height / 3:.1f} " \
              f"{cx + half:.1f},{cy + height / 3:.1f}"
        shapes.append(f"<polygon points='{pts}' fill='{color}' fill-opacity='{rnd.uniform(lo, hi):.3f}'/>")
    svg = (f"<svg xmlns='http://www.w3.org/2000/svg' width='{w}' height='{h}' "
           f"viewBox='0 0 {w} {h}'>{''.join(shapes)}</svg>")
    return "data:image/svg+xml;base64," + base64.b64encode(svg.encode()).decode()


# lazer groups mods by category and colours them accordingly.
MOD_CATEGORY = {
    "EZ": "reduction", "NF": "reduction", "HT": "reduction", "DC": "reduction",
    "HR": "increase", "SD": "increase", "PF": "increase", "DT": "increase",
    "NC": "increase", "HD": "increase", "FL": "increase", "AC": "increase",
    "BL": "increase", "SG": "increase",
    "RX": "automation", "AP": "automation", "SO": "automation", "CN": "automation",
    "TP": "automation",
}


def mod_class(acronym):
    return "mod-" + MOD_CATEGORY.get(acronym.upper(), "fun")


# ------------------------------------------------------------------ helpers --

def parse_iso(s):
    if not s:
        return None
    try:
        dt = datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except ValueError:
        return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)


def local(dt):
    return dt.astimezone() if dt else None


def fmt_when(dt):
    dt = local(dt)
    return dt.strftime("%d %b, %I:%M %p").lstrip("0").replace(" 0", " ") if dt else ""


def fmt_ago(dt):
    if not dt:
        return ""
    secs = (datetime.now(timezone.utc) - dt).total_seconds()
    if secs < 90:
        return "just now"
    for size, name in ((3600, "m"), (86400, "h"), (604800, "d")):
        if secs < size:
            unit = size // 60 if name == "m" else (3600 if name == "h" else 86400)
            return f"{int(secs // unit)}{name} ago"
    return f"{int(secs // 604800)}w ago"


def fmt_dur(seconds):
    if not seconds:
        return "0m"
    d, rem = divmod(int(seconds), 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return f"{d}d {h}h"
    return f"{h}h {m}m" if h else f"{m}m"


def esc(s):
    return html.escape(str(s if s is not None else ""))


def pct_rank(values, v):
    """Fraction of `values` that v is better than (lower is better)."""
    if not values:
        return 0.5
    return sum(1 for x in values if x > v) / len(values)


def percentile(values, q):
    if not values:
        return None
    s = sorted(values)
    i = (len(s) - 1) * q
    lo, hi = math.floor(i), math.ceil(i)
    return s[lo] if lo == hi else s[lo] + (s[hi] - s[lo]) * (i - lo)


def lerp_hex(a, b, t):
    a, b = a.lstrip("#"), b.lstrip("#")
    out = []
    for i in (0, 2, 4):
        ca, cb = int(a[i:i + 2], 16), int(b[i:i + 2], 16)
        out.append(f"{int(round(ca + (cb - ca) * t)):02x}")
    return "#" + "".join(out)


# osu!'s difficulty spectrum, sampled at its published stops.
STAR_STOPS = [
    (0.1, "#4290fb"), (1.25, "#4fc0ff"), (2.0, "#4fffd5"), (2.5, "#7cff4f"),
    (3.3, "#f6f05c"), (4.2, "#ff8068"), (4.9, "#ff4e6f"), (5.8, "#c645b8"),
    (6.7, "#6563de"), (7.7, "#18158e"), (9.0, "#000000"),
]


def star_color(sr):
    sr = float(sr or 0)
    if sr <= STAR_STOPS[0][0]:
        return STAR_STOPS[0][1]
    for (s0, c0), (s1, c1) in zip(STAR_STOPS, STAR_STOPS[1:]):
        if sr <= s1:
            return lerp_hex(c0, c1, (sr - s0) / (s1 - s0))
    return STAR_STOPS[-1][1]


def readable_on(hex_color):
    """Black or white text, whichever contrasts better with the pill colour."""
    c = hex_color.lstrip("#")
    r, g, b = (int(c[i:i + 2], 16) / 255 for i in (0, 2, 4))
    lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
    return "#0b0b12" if lum > 0.45 else "#ffffff"


GRADE_COLORS = {
    "XH": "#e8eef5", "X": "#ffd966", "SH": "#e8eef5", "S": "#ffd966",
    "A": "#b3d944", "B": "#66ccff", "C": "#aa88ff", "D": "#ff6666", "F": "#8b7f92",
}

GRADE_LABELS = {"XH": "SS", "X": "SS", "SH": "S", "S": "S", "F": "F"}

# SS and S are both gold in osu!; split them light/dark so a ring stays
# readable without inventing a colour that means nothing
GRADE_RING_COLORS = {"SS": "#ffd966", "S": "#eeaa00", "A": "#b3d944",
                     "B": "#66ccff", "C": "#aa88ff", "D": "#ff6666",
                     "F": "#8b7f92"}


def grade_of(score):
    """Prefer the API's own grade; fall back to accuracy when absent."""
    r = score.get("rank")
    if isinstance(r, str) and r:
        return r.upper()
    acc = (score.get("accuracy") or 0) * 100
    for cut, g in ((100, "X"), (95, "S"), (90, "A"), (80, "B"), (70, "C")):
        if acc >= cut:
            return g
    return "D"


def mods_of(score):
    mods = score.get("mods") or []
    out = []
    for m in mods:
        acr = m.get("acronym") if isinstance(m, dict) else str(m)
        if acr and acr not in ("CL",):      # classic mod is noise on lazer scores
            out.append(acr)
    return out


# ------------------------------------------------------------------- charts --

def nice_ticks(lo, hi, n=4):
    if hi <= lo:
        pad = abs(lo) * 0.05 or 1.0
        return [lo], lo - pad, hi + pad
    raw = (hi - lo) / n
    mag = 10 ** math.floor(math.log10(raw))
    step = mag * 10
    for m in (1, 2, 2.5, 5, 10):
        if raw <= m * mag:
            step = m * mag
            break
    start = math.floor(lo / step) * step
    end = math.ceil(hi / step) * step
    ticks, v = [], start
    while v <= end + step * 1e-9:
        ticks.append(round(v, 10))
        v += step
    return ticks, start, end


def svg_timeseries(points, color, yfmt, invert=False, w=520, h=190, area=True):
    """points: [(datetime, value)] -> an SVG string, or an empty-state div."""
    points = [(t, v) for t, v in points if t is not None and v is not None]
    if len(points) < 2:
        return "<div class='empty'>not enough data yet</div>"
    points.sort(key=lambda p: p[0])

    pad_l, pad_r, pad_t, pad_b = 54, 14, 14, 26
    pw, ph = w - pad_l - pad_r, h - pad_t - pad_b
    vals = [v for _, v in points]
    ticks, ymin, ymax = nice_ticks(min(vals), max(vals))
    t0, t1 = points[0][0], points[-1][0]
    span = (t1 - t0).total_seconds() or 1

    def X(t):
        return pad_l + (t - t0).total_seconds() / span * pw

    def Y(v):
        f = (v - ymin) / (ymax - ymin or 1)
        if invert:
            f = 1 - f
        return pad_t + (1 - f) * ph

    uid = f"g{abs(hash((color, w, len(points), vals[0]))) % 100000}"
    parts = [f"<svg viewBox='0 0 {w} {h}' class='chart' role='img'>"]
    parts.append(
        f"<defs><linearGradient id='{uid}' x1='0' y1='0' x2='0' y2='1'>"
        f"<stop offset='0%' stop-color='{color}' stop-opacity='.32'/>"
        f"<stop offset='100%' stop-color='{color}' stop-opacity='0'/>"
        f"</linearGradient></defs>"
    )

    for tv in ticks:
        y = Y(tv)
        if not (pad_t - 1 <= y <= pad_t + ph + 1):
            continue
        parts.append(f"<line x1='{pad_l}' y1='{y:.1f}' x2='{w - pad_r}' y2='{y:.1f}' class='grid'/>")
        parts.append(f"<text x='{pad_l - 8}' y='{y + 3.5:.1f}' class='axis' text-anchor='end'>{esc(yfmt(tv))}</text>")

    line = " ".join(f"{X(t):.1f},{Y(v):.1f}" for t, v in points)
    if area:
        floor = pad_t + ph
        parts.append(f"<polygon points='{pad_l:.1f},{floor} {line} {w - pad_r:.1f},{floor}' fill='url(#{uid})'/>")
    parts.append(f"<polyline points='{line}' fill='none' stroke='{color}' stroke-width='2' "
                 f"stroke-linejoin='round' stroke-linecap='round'/>")

    for t, v in points:
        parts.append(f"<circle class='pt' cx='{X(t):.1f}' cy='{Y(v):.1f}' r='3' fill='{color}' "
                     f"data-tip='{esc(yfmt(v) + chr(10) + fmt_when(t))}'/>")

    for t, anchor in ((t0, "start"), (t1, "end")):
        parts.append(f"<text x='{X(t):.1f}' y='{h - 8}' class='axis' text-anchor='{anchor}'>"
                     f"{esc(local(t).strftime('%d %b'))}</text>")
    parts.append("</svg>")
    return "".join(parts)


def svg_scatter_trend(rows, w=520, h=280):
    """UR against time, with a least-squares trend line."""
    pts = [(parse_iso(r.get("played_at")), r.get("ur")) for r in rows]
    pts = [(t, v) for t, v in pts if t and v]
    if len(pts) < 3:
        return "<div class='empty'>not enough replays yet</div>"
    pts.sort(key=lambda p: p[0])

    pad_l, pad_r, pad_t, pad_b = 54, 14, 14, 26
    pw, ph = w - pad_l - pad_r, h - pad_t - pad_b
    vals = [v for _, v in pts]
    ticks, ymin, ymax = nice_ticks(min(vals), max(vals))
    t0, t1 = pts[0][0], pts[-1][0]
    span = (t1 - t0).total_seconds() or 1

    def X(t):
        return pad_l + (t - t0).total_seconds() / span * pw

    def Y(v):
        return pad_t + (1 - (v - ymin) / (ymax - ymin or 1)) * ph

    parts = [f"<svg viewBox='0 0 {w} {h}' class='chart' role='img' data-cross='1'>"]
    parts.append(f"<line class='crosshair' x1='0' y1='{pad_t}' x2='0' y2='{pad_t + ph}'/>")
    parts.append(f"<rect x='{pad_l}' y='{pad_t}' width='{pw}' height='{ph}' "
                 f"fill='none' pointer-events='all'/>")
    for tv in ticks:
        y = Y(tv)
        if not (pad_t - 1 <= y <= pad_t + ph + 1):
            continue
        parts.append(f"<line x1='{pad_l}' y1='{y:.1f}' x2='{w - pad_r}' y2='{y:.1f}' class='grid'/>")
        parts.append(f"<text x='{pad_l - 8}' y='{y + 3.5:.1f}' class='axis' text-anchor='end'>{tv:.0f}</text>")

    xs = [(t - t0).total_seconds() for t, _ in pts]
    mx, my = mean(xs), mean(vals)
    denom = sum((x - mx) ** 2 for x in xs)
    if denom:
        slope = sum((x - mx) * (y - my) for x, y in zip(xs, vals)) / denom
        y_a, y_b = my + slope * (xs[0] - mx), my + slope * (xs[-1] - mx)
        y_a, y_b = max(ymin, min(ymax, y_a)), max(ymin, min(ymax, y_b))
        parts.append(f"<line x1='{pad_l}' y1='{Y(y_a):.1f}' x2='{w - pad_r}' y2='{Y(y_b):.1f}' "
                     f"class='trend'/>")

    for (t, v), r in zip(pts, sorted([r for r in rows if parse_iso(r.get('played_at')) and r.get('ur')],
                                     key=lambda r: parse_iso(r['played_at']))):
        c = star_color(r.get("stars"))
        tip = (f"{r.get('title', '')[:46]}\n"
               f"UR {v:.0f} · {r.get('stars') or 0:.2f}★\n"
               f"{fmt_when(t)}")
        parts.append(f"<circle class='pt' cx='{X(t):.1f}' cy='{Y(v):.1f}' r='4.5' fill='{c}' "
                     f"fill-opacity='.85' stroke='#150d14' stroke-width='.9' "
                     f"data-tip='{esc(tip)}'/>")

    for t, anchor in ((t0, "start"), (t1, "end")):
        parts.append(f"<text x='{X(t):.1f}' y='{h - 8}' class='axis' text-anchor='{anchor}'>"
                     f"{esc(local(t).strftime('%d %b'))}</text>")
    parts.append("</svg>")
    return "".join(parts)


def svg_donut(slices, note="", size=210, center=None):
    """
    Ring chart from stroke-dasharray segments — no arc-path maths, and each
    segment is a single element that can carry its own tooltip.

    slices: [(label, value, colour)]
    """
    slices = [(lab, v, c) for lab, v, c in slices if v]
    total = sum(v for _, v, _ in slices)
    if not total:
        return "<div class='empty'>no data</div>"

    r, sw = 62, 26
    circ = 2 * math.pi * r
    cx = cy = size / 2
    out = [f"<svg viewBox='0 0 {size} {size}' class='donut' role='img'>"]
    out.append(f"<circle cx='{cx}' cy='{cy}' r='{r}' fill='none' "
               f"stroke='rgba(255,255,255,.06)' stroke-width='{sw}'/>")
    acc = 0.0
    for lab, v, c in slices:
        frac = v / total
        seg = frac * circ
        tip = f"{lab}\n{v:,} ({frac * 100:.1f}%)"
        out.append(
            f"<circle class='seg' cx='{cx}' cy='{cy}' r='{r}' fill='none' stroke='{c}' "
            f"stroke-width='{sw}' stroke-dasharray='{seg:.2f} {circ - seg:.2f}' "
            f"stroke-dashoffset='{-acc * circ:.2f}' "
            f"transform='rotate(-90 {cx} {cy})' data-tip='{esc(tip)}'/>")
        acc += frac
    # the centre defaults to the dominant slice, but a caller can name a more
    # useful headline — "30% F" is true and useless as a summary of a session
    if center is None:
        biggest = max(slices, key=lambda s: s[1])
        center = (f"{biggest[1] / total * 100:.0f}%", biggest[0])
    out.append(f"<text x='{cx}' y='{cy - 2}' class='dn-big' text-anchor='middle'>"
               f"{esc(center[0])}</text>")
    out.append(f"<text x='{cx}' y='{cy + 16}' class='dn-sub' text-anchor='middle'>"
               f"{esc(center[1])}</text>")
    out.append("</svg>")

    legend = "".join(
        f"<div class='dn-row'><i style='background:{c}'></i>"
        f"<span class='dn-l'>{esc(lab)}</span>"
        f"<span class='dn-v'>{v:,}</span>"
        f"<span class='dn-p'>{v / total * 100:.1f}%</span></div>"
        for lab, v, c in slices)
    foot = f"<div class='dn-note'>{esc(note)}</div>" if note else ""
    return (f"<div class='donut-wrap'>{''.join(out)}"
            f"<div class='dn-legend'>{legend}{foot}</div></div>")


def linreg(pairs):
    """(slope, intercept) by least squares, or None when undetermined."""
    pts = [(x, y) for x, y in pairs if x is not None and y is not None]
    if len(pts) < 3:
        return None
    xs = [p[0] for p in pts]
    ys = [p[1] for p in pts]
    mx, my = mean(xs), mean(ys)
    denom = sum((x - mx) ** 2 for x in xs)
    if not denom:
        return None
    slope = sum((x - mx) * (y - my) for x, y in zip(xs, ys)) / denom
    return slope, my - slope * mx


def svg_pp_scatter(scores, w=1140, h=340):
    """
    Every top play as a point: when it was set against what it was worth.

    The trend line answers the question the table cannot — whether the plays
    being added lately are worth more than the ones they are replacing.
    """
    pts = []
    for s in scores:
        t = parse_iso(s.get("ended_at") or s.get("created_at"))
        pp = s.get("pp")
        if t and pp:
            pts.append((t, pp, s))
    if len(pts) < 3:
        return "<div class='empty'>not enough dated plays yet</div>"
    pts.sort(key=lambda p: p[0])

    pad_l, pad_r, pad_t, pad_b = 54, 18, 18, 32
    pw, ph = w - pad_l - pad_r, h - pad_t - pad_b
    # five divisions keeps the top tick close to the real maximum; four would
    # round a 43pp best all the way up to 60 and waste a third of the height
    ticks, ymin, ymax = nice_ticks(0, max(p[1] for p in pts), 5)
    t0, t1 = pts[0][0], pts[-1][0]
    span = (t1 - t0).total_seconds() or 1

    def X(t):
        return pad_l + (t - t0).total_seconds() / span * pw

    def Y(v):
        return pad_t + (1 - (v - ymin) / (ymax - ymin or 1)) * ph

    out = [f"<svg viewBox='0 0 {w} {h}' class='chart chart-tall' role='img' data-cross='1'>"]
    out.append(f"<line class='crosshair' x1='0' y1='{pad_t}' x2='0' y2='{pad_t + ph}'/>")
    out.append(f"<rect x='{pad_l}' y='{pad_t}' width='{pw}' height='{ph}' "
                 f"fill='none' pointer-events='all'/>")
    for tv in ticks:
        y = Y(tv)
        if not (pad_t - 1 <= y <= pad_t + ph + 1):
            continue
        out.append(f"<line x1='{pad_l}' y1='{y:.1f}' x2='{w - pad_r}' y2='{y:.1f}' class='grid'/>")
        out.append(f"<text x='{pad_l - 9}' y='{y + 3.5:.1f}' class='axis' text-anchor='end'>{tv:.0f}</text>")

    # six evenly spaced date labels along the bottom
    for i in range(6):
        t = t0 + (t1 - t0) * (i / 5)
        anchor = "start" if i == 0 else "end" if i == 5 else "middle"
        out.append(f"<text x='{X(t):.1f}' y='{h - 10}' class='axis' text-anchor='{anchor}'>"
                   f"{esc(local(t).strftime('%d %b'))}</text>")

    fit = linreg([((t - t0).total_seconds(), pp) for t, pp, _ in pts])
    if fit:
        slope, intercept = fit
        ya = max(ymin, min(ymax, intercept))
        yb = max(ymin, min(ymax, slope * span + intercept))
        out.append(f"<line x1='{pad_l}' y1='{Y(ya):.1f}' x2='{w - pad_r}' y2='{Y(yb):.1f}' "
                   f"class='trend-pp'/>")

    for t, pp, s in pts:
        g = grade_of(s)
        c = GRADE_COLORS.get(g, "#8b7f92")
        bms = s.get("beatmapset") or {}
        bm = s.get("beatmap") or {}
        tip = (f"{bms.get('title', '?')} [{bm.get('version', '')}]\n"
               f"{pp:.2f}pp · {(s.get('accuracy') or 0) * 100:.2f}% · "
               f"{GRADE_LABELS.get(g, g[0])} · {bm.get('difficulty_rating') or 0:.2f}★"
               f" · {bm.get('bpm') or '?'}bpm · AR{bm.get('ar') or '?'}\n"
               f"{fmt_when(t)}  ({fmt_ago(t)})\n"
               f"click to open on osu.ppy.sh ↗")
        url = bm.get("url") or ""
        # data-series groups the point with the rest of its grade, so hovering
        # one lifts the whole series and fades the others
        out.append(
            f"<a href='{esc(url)}' target='_blank' rel='noopener'>"
            f"<circle class='pt' cx='{X(t):.1f}' cy='{Y(pp):.1f}' r='5' fill='{c}' "
            f"fill-opacity='.85' stroke='#150d14' stroke-width='1' "
            f"data-series='{esc(GRADE_LABELS.get(g, g[0]))}' "
            f"data-tip='{esc(tip)}'/></a>")
    out.append("</svg>")

    order = ["SS", "S", "A", "B", "C", "D", "F"]
    seen = sorted({GRADE_LABELS.get(grade_of(s), grade_of(s)[0]) for _, _, s in pts},
                  key=lambda g: order.index(g) if g in order else len(order))
    legend = "".join(
        f"<span class='lg'><i style='background:"
        f"{GRADE_COLORS.get(g if g != 'SS' else 'X', '#8b7f92')}'></i>{esc(g)}</span>"
        for g in seen)
    legend += "<span class='lg'><i class='lg-line'></i>trend</span>"
    return "".join(out) + f"<div class='legend'>{legend}</div>"


STAR_BANDS = [(0, 2.5, "under 2.5★"), (2.5, 3.0, "2.5 – 3.0★"),
              (3.0, 3.5, "3.0 – 3.5★"), (3.5, 4.0, "3.5 – 4.0★"),
              (4.0, 99, "4.0★ and up")]


def render_star_bands(rows):
    """Median UR per star band — does precision hold up as maps get harder?"""
    buckets = []
    for lo, hi, label in STAR_BANDS:
        vals = [r for r in rows if r.get("ur") and lo <= (r.get("stars") or 0) < hi]
        if vals:
            buckets.append((label, lo, hi, [r["ur"] for r in vals],
                            [r["accuracy"] for r in vals if r.get("accuracy")]))
    if not buckets:
        return "<div class='empty'>no replay data yet</div>"

    hi_ur = max(max(u) for _, _, _, u, _ in buckets)
    out = ["<div class='bands'>"]
    for label, lo, hi, urs, accs in buckets:
        med = median(urs)
        color = star_color((lo + min(hi, lo + 1)) / 2)
        width = med / hi_ur * 100
        acc_txt = f"{mean(accs):.1f}% acc" if accs else ""
        out.append(
            f"<div class='band'>"
            f"<div class='band-label'>{esc(label)}<span class='band-n'>{len(urs)} play{'s' if len(urs) != 1 else ''}</span></div>"
            f"<div class='band-track'><div class='band-fill' style='width:{width:.1f}%;"
            f"background:linear-gradient(90deg,{color}55,{color})'></div>"
            f"<span class='band-val'>{med:.0f} UR</span></div>"
            f"<div class='band-sub'>{esc(acc_txt)}</div>"
            f"</div>"
        )
    out.append("</div>")
    return "".join(out)


def render_acc_histogram(scores):
    """Where accuracy actually lands across the plays in view."""
    accs = [(s.get("accuracy") or 0) * 100 for s in scores]
    if len(accs) < 3:
        return "<div class='empty'>not enough plays</div>"
    edges = [(0, 70), (70, 80), (80, 85), (85, 90), (90, 95), (95, 100.01)]
    labels = ["<70", "70-80", "80-85", "85-90", "90-95", "95+"]
    counts = [sum(1 for a in accs if lo <= a < hi) for lo, hi in edges]
    top = max(counts) or 1
    bars = []
    for label, c in zip(labels, counts):
        pct = c / top * 100
        cls = " zero" if not c else ""
        bars.append(
            f"<div class='hbar{cls}'><div class='hbar-col'>"
            f"<div class='hbar-fill' style='height:{pct:.1f}%'></div></div>"
            f"<div class='hbar-n'>{c}</div><div class='hbar-l'>{esc(label)}</div></div>"
        )
    return f"<div class='hist'>{''.join(bars)}</div>"


# -------------------------------------------------------------- play tables --

def play_row(i, score, ur_entry, ur_lo, ur_hi):
    bm = score.get("beatmap") or {}
    bms = score.get("beatmapset") or {}
    stats = score.get("statistics") or {}
    sr = bm.get("difficulty_rating") or 0
    sc = star_color(sr)
    acc = (score.get("accuracy") or 0) * 100
    pp = score.get("pp")
    grade = grade_of(score)
    gc = GRADE_COLORS.get(grade, "#8b8a9b")
    misses = stats.get("miss") or stats.get("count_miss") or 0
    combo = score.get("max_combo")
    when = parse_iso(score.get("ended_at") or score.get("created_at"))
    mods = mods_of(score)

    if ur_entry and ur_entry.get("ur"):
        ur = ur_entry["ur"]
        cls = "ur-good" if ur <= ur_lo else "ur-bad" if ur >= ur_hi else "ur-mid"
        ur_cell = f"<span class='ur {cls}' title='unstable rate, lower is steadier'>{ur:.0f}</span>"
    else:
        ur_cell = "<span class='ur ur-none' title='no replay stored for this score'>–</span>"

    mod_html = "".join(f"<span class='mod {mod_class(m)}'>{esc(m)}</span>" for m in mods) or \
               "<span class='mod mod-nm'>NM</span>"

    letter = GRADE_LABELS.get(grade, grade[0])
    g_size = "11px" if len(letter) > 1 else "14px"

    return (
        f"<div class='play' style='--sr:{sc}'>"
        f"<div class='p-idx'>{i}</div>"
        f"<div class='p-star'><span class='sr' style='background:{sc};color:{readable_on(sc)}'>"
        f"<i>★</i>{sr:.2f}</span></div>"
        f"<div class='p-map'>"
        f"<a class='p-title' href='{esc(bm.get('url') or '#')}' target='_blank' "
        f"rel='noopener' title='open this difficulty on osu.ppy.sh'>"
        f"{esc(bms.get('title', '?'))}<span class='ext'>↗</span></a>"
        f"<div class='p-meta'><span class='p-diff'>{esc(bm.get('version', ''))}</span>"
        f"<span class='p-artist'>{esc(bms.get('artist', ''))}</span></div>"
        f"</div>"
        f"<div class='p-mods'>{mod_html}</div>"
        f"<div class='p-grade'><span class='grade' style='background:{gc};font-size:{g_size}'>"
        f"{esc(letter)}</span></div>"
        f"<div class='p-acc'><div class='acc-n'>{acc:.2f}%</div>"
        f"<div class='acc-bar'><i style='width:{max(0, min(100, (acc - 60) / 40 * 100)):.1f}%'></i></div></div>"
        f"<div class='p-pp'>{f'{pp:.0f}' if pp else '–'}<small>pp</small></div>"
        f"<div class='p-ur'>{ur_cell}</div>"
        f"<div class='p-misc'>"
        f"{f'<span class=miss>{misses}✕</span>' if misses else '<span class=fc>FC</span>' if combo else ''}"
        f"<span class='p-when'>{esc(fmt_ago(when))}</span></div>"
        f"</div>"
    )


def play_table(scores, ur_map, ur_lo, ur_hi, empty_msg):
    if not scores:
        return f"<div class='empty'>{esc(empty_msg)}</div>"
    head = ("<div class='play head'><div class='p-idx'></div><div class='p-star'>diff</div>"
            "<div class='p-map'>map</div><div class='p-mods'>mods</div><div class='p-grade'></div>"
            "<div class='p-acc'>accuracy</div><div class='p-pp'>pp</div><div class='p-ur'>UR</div>"
            "<div class='p-misc'></div></div>")
    rows = [play_row(i, s, ur_map.get(ost._score_key(s)), ur_lo, ur_hi)
            for i, s in enumerate(scores, 1)]
    return f"<div class='plays'>{head}{''.join(rows)}</div>"


# ------------------------------------------------------------------- stat ui --

def stat(label, value, sub="", delta_html="", accent=None):
    style = f" style='color:{accent}'" if accent else ""
    return (
        f"<div class='stat'><div class='s-label'>{esc(label)}</div>"
        f"<div class='s-value'{style}>{value}</div>"
        f"<div class='s-sub'>{sub}{delta_html}</div></div>"
    )


def delta_html(new, old, fmt=None, invert=False):
    """
    Change since the start of the session, formatted by `fmt`.
    invert=True means a decrease is an improvement (rank, UR).
    """
    if new is None or old is None:
        return ""
    fmt = fmt or (lambda v: f"{v:,.0f}")
    d = new - old
    if not round(d, 4):
        return "<span class='d flat'>no change</span>"
    good = (d < 0) if invert else (d > 0)
    arrow = "▲" if d > 0 else "▼"
    return f"<span class='d {'up' if good else 'down'}'>{arrow} {fmt(abs(d))}</span>"


